# آدرس فایل دیتابیس SQLite
DATABASE_URL="file:/absolute/path/to/db/custom.db"

# کلید رمزنگاری (برای رمز پنل و نشست‌ها) — یک رشته تصادفی طولانی بگذارید
APP_SECRET="change-this-to-a-long-random-string"

# حساب ادمین پنل — رمز پیش‌فرض ثابتی وجود ندارد؛ اگر خالی بماند رمز تصادفی تولید می‌شود
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
